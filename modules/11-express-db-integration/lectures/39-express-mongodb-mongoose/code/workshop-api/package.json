{
  "name": "workshop-express-mongoose-lecture39",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mts",
    "dev": "node --env-file-if-exists=.env --watch src/server.mts",
    "validate-demo": "node --env-file-if-exists=.env src/validate-demo.mts",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test tests/workshop-core.test.mts",
    "demo:validate": "node --env-file-if-exists=.env scripts/validation-demo.mts",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mts",
    "demo:index": "node --env-file-if-exists=.env scripts/create-index.mts",
    "demo:query": "node --env-file-if-exists=.env scripts/query-demo.mts",
    "test:activity": "node --env-file-if-exists=.env scripts/activity-check.mts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.12.1",
    "morgan": "1.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
